generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // user or admin
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews   Review[]
  downloads Download[]
}

model Resource {
  id           String   @id @default(uuid())
  title        String
  description  String
  author       String
  type         String   // textbook, research_paper, study_guide, video, article
  subject      String
  gradeLevel   String
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  downloadCount Int     @default(0)
  tags         String   // JSON string array
  thumbnail    String?
  fileSize     String
  filePath     String?  // Path to uploaded file
  uploadDate   String
  language     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews   Review[]
  downloads Download[]
}

model Review {
  id          String   @id @default(uuid())
  resourceId  String
  userId      String
  userName    String
  rating      Int
  comment     String
  date        String
  helpful     Int      @default(0)
  unhelpful   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Download {
  id          String   @id @default(uuid())
  resourceId  String
  userId      String
  downloadedAt DateTime @default(now())

  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
